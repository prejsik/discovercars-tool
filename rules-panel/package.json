{
  "name": "discovercars-rules-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:engine": "node tests/engine-compat.mjs",
    "test:worker": "node --test tests/worker.test.mjs && node tests/worker-runtime.mjs",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "test:ui": "node tests/ui.mjs && node tests/concurrency-ui.mjs && node tests/preview-labels-ui.mjs && node tests/director-ui.mjs",
    "test:storage": "node tests/storage-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  }
}
